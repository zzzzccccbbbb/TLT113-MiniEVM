config COMPONENTS_ALGO_GENERATE
	bool "Algorithm generate"
	default n
	depends on COMPONENTS_ALGO_COMMON
	help
	  This is install generate algorithm.

config COMPONENTS_ALGO_EQ
	bool "EQ Algorithm"
	default n
	depends on COMPONENTS_ALGO_GENERATE
	help
	  This is enable EQ algorithm.

config COMPONENTS_ALGO_AEC
	bool "AEC Algorithm"
	default n
	depends on COMPONENTS_ALGO_GENERATE
	help
	  This is enable AEC algorithm.
