From: Build fix for GNU Make >= 4.3
Subject: [PATCH] Fix build with GNU Make >= 4.3

Make 4.3 changed \# handling; use H := \# and $(H)include.
Based on https://bugs.gentoo.org/705974

diff -ruN orig/common/glib-gen.mak new/common/glib-gen.mak
--- a/common/glib-gen.mak	2018-03-24 04:44:59.000000000 +0800
+++ b/common/glib-gen.mak	2026-08-10 15:33:00.964892335 +0800
@@ -1,11 +1,13 @@
 # these are the variables your Makefile.am should set
 # the example is based on the colorbalance interface
 
+H := \#
+
 #glib_enum_headers=$(colorbalance_headers)
 #glib_enum_define=GST_COLOR_BALANCE
 #glib_enum_prefix=gst_color_balance
 
-enum_headers=$(foreach h,$(glib_enum_headers),\n\#include \"$(h)\")
+enum_headers=$(foreach h,$(glib_enum_headers),\n$(H)include \"$(h)\")
 
 # these are all the rules generating the relevant files
 %-marshal.h: %-marshal.list
